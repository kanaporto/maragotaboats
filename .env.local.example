# Supabase (Opcional - para versión con BD real)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Resend (emails de confirmación de reserva, solicitudes de franquicia)
# Crea la cuenta en https://resend.com, verifica el dominio maragotaboats.com
# y pega la API key aquí. Solo la usan las Pages Functions del servidor
# (functions/api/send-confirmation-email.ts, functions/api/franchise-lead.ts)
# → en Cloudflare Pages: Settings > Functions > Secrets.
# Sin esta clave, el sitio sigue funcionando pero no se envía ningún email real.
RESEND_API_KEY=your_resend_api_key_here

# Google Maps (Opcional - para geocoding real)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Stripe (Apple Pay + Google Pay + Bizum)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY se usa en el navegador (build-time) → en
#   Cloudflare Pages: Settings > Environment variables (Build)
# STRIPE_SECRET_KEY solo lo usa la Pages Function del servidor, nunca el
#   navegador → en Cloudflare Pages: Settings > Functions > Secrets
# Ver STRIPE_SETUP.md para el detalle completo del alta.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# Cloudflare Web Analytics (opcional, gratis, sin cookies)
# 1. Cloudflare Dashboard → Analytics & Logs → Web Analytics → Add a site
# 2. Hostname: maragota-boats.pages.dev (o tu dominio final)
# 3. Copia el "Site token" que te dan y pégalo aquí
# → en Cloudflare Pages: Settings > Environment variables (Build), porque se
#   usa en el navegador (NEXT_PUBLIC_)
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=your_cf_analytics_token_here

# Cloudflare (Automático en Pages)
# No necesita configuración manual
